# =============================================================================
# VegDrop — PRODUCTION environment checklist
#
# This is the subset of .env.example that actually matters for a live
# deployment, in the order config/env.js checks them, with what happens if you
# get each one wrong. Copy this to /var/www/vegdrop/.env on the VM, fill in
# every value, then delete the comments if you want — the app doesn't read them.
#
# Full reference with every optional knob: ../.env.example
# =============================================================================

NODE_ENV=production
PORT=5000

# --- Database -----------------------------------------------------------
# MUST be an Atlas connection string (or any deployment that is a real replica
# set). config/env.js checks the topology at connect time and refuses to serve
# traffic in production on a standalone mongod — the wallet ledger and order
# checkout use multi-document transactions, which a standalone server cannot
# run. Get this from Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vegdrop?retryWrites=true&w=majority

# --- Session secrets ------------------------------------------------------
# Boot ABORTS without these. Generate each separately — reusing one value for
# both access and refresh means a leak of one compromises both token types.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Mixed into OTP hashes. Generate the same way. Boot ABORTS without it.
OTP_PEPPER=

# --- CORS -------------------------------------------------------------------
# REQUIRED in production — boot ABORTS if empty. Comma-separated, no trailing
# slash. If Caddy serves the frontend from the same origin as the API (the
# deploy/Caddyfile setup), this only needs to be that one origin.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Caddy sits in front of Express as a reverse proxy, so without this every
# request appears to come from 127.0.0.1 — rate limiting would throttle
# everyone as a single client, and secure cookies would misjudge the scheme.
TRUST_PROXY=1

# --- OTP delivery -------------------------------------------------------
# Sign-in is passwordless: the code is the whole credential, so it is always
# sent to the phone number. There is nothing to configure about where it goes,
# only about what delivers it.
#
# `whatsapp` is the only transport production accepts — the official Cloud API,
# using a Meta-approved template of category AUTHENTICATION.
#
# An unofficial WhatsApp Web client used to be an option here, and this file
# used to default to it. Both are gone. Sign-in is passwordless, so whatever
# delivers the code IS the authentication system: a number banned for breaching
# WhatsApp's Terms of Service takes every user's access with it, at once, with
# no way back in.
NOTIFY_TRANSPORT=whatsapp

# --- Required by NOTIFY_TRANSPORT=whatsapp ---------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=

# --- Payments -------------------------------------------------------------
# REQUIRED in production — boot ABORTS on missing or placeholder-looking
# credentials (mock payment mode is refused outside development).
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=

# =============================================================================
# NOT in this file, and that's fine: everything else in .env.example (OTP
# timing, lockout policy, JWT TTLs, webhook secrets) has a safe default and
# only needs setting if you want to change the default behaviour.
# =============================================================================

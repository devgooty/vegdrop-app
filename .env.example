# =============================================================================
# VegDrop — server configuration
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.
#
# IMPORTANT: Vite inlines any variable prefixed VITE_ into the browser bundle.
# Never put a password, API secret, or connection string behind a VITE_ prefix.
# Everything below is server-side only and deliberately unprefixed.
#
# Role membership is no longer configured here. A user's role lives on their
# database record and is assigned by an admin via PATCH /api/users/:id/role.
# =============================================================================

NODE_ENV=development
PORT=5000

# --- Database ----------------------------------------------------------------
# Local development. Production requires a replica set: the wallet ledger and
# order checkout use multi-document transactions, which a standalone mongod
# cannot run (the server refuses to boot in production without them).
MONGODB_URI=mongodb://127.0.0.1:27017/vegdrop
# Atlas — substitute your own cluster, user, and password:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vegdrop?retryWrites=true&w=majority

# --- Session secrets ---------------------------------------------------------
# Required in production; the process aborts at boot if absent. In development a
# random ephemeral secret is generated per run (sessions reset on restart).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Mixed into OTP hashes so a database leak alone does not reveal live codes.
OTP_PEPPER=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- CORS --------------------------------------------------------------------
# Comma-separated absolute origins. Required in production.
# Do NOT widen this to a private-network range: every device on the same Wi-Fi
# would then be able to drive the API with credentials attached.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set when running behind a reverse proxy so rate limiting sees the real client
# IP rather than the proxy's.
# TRUST_PROXY=1

# --- Authentication policy ---------------------------------------------------
AUTH_MIN_PASSWORD_LENGTH=10
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCKOUT_SECONDS=900

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- OTP delivery ------------------------------------------------------------
# Which transport delivers codes to phone numbers:
#   console      dev stub, prints codes to stdout (REFUSED IN PRODUCTION)
#   whatsapp     official Cloud API — approved template, paid per message
#   whatsapp_bot UNOFFICIAL WhatsApp Web client via server/bot — free, but
#                against WhatsApp's ToS and the number can be banned.
#                See server/bot/README.md before choosing this.
# Defaults to `whatsapp` once the Cloud API values below are set.
# NOTIFY_TRANSPORT=whatsapp

# There is no OTP_CHANNEL setting. Sign-in is passwordless, so the code IS the
# credential and is always addressed to the phone number — addressing it to an
# email would be a second, weaker way into the account.
#
# From Meta: App dashboard → WhatsApp → API Setup.
# Use a permanent System User token, not the 24-hour test token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
#
# The name of an APPROVED template of category AUTHENTICATION. WhatsApp does not
# permit free-form business-initiated messages, so codes can only be sent through
# a template Meta approved in advance. Its body must contain exactly one
# variable — the code.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LOCALE=en
#
# Authentication templates normally carry a copy-code button, which needs the code
# repeated as its parameter. If yours has no button, set this to false — otherwise
# Meta rejects the extra component with error 132000.
# WHATSAPP_OTP_INCLUDE_BUTTON=true
# WHATSAPP_OTP_BUTTON_SUBTYPE=url
#
# Phone numbers are stored as 10 local digits; this is prepended when sending.
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_MS=10000
#
# --- WhatsApp webhook (delivery receipts) ------------------------------------
# Optional but strongly recommended: the send API returns success as soon as Meta
# ACCEPTS a message, so without these a code that never arrived looks identical to
# one that did. Point Meta at https://<your-host>/api/whatsapp/webhook
#
# Any string you choose; Meta echoes it back during the subscription handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App dashboard → Settings → Basic → App Secret. Authenticates inbound webhook
# calls via X-Hub-Signature-256; without it the endpoint refuses every POST.
WHATSAPP_APP_SECRET=

# --- Email copies of login codes ---------------------------------------------
# Optional. When SMTP_HOST and SMTP_FROM are both set, a login code is ALSO sent
# to the account's email — but only to an address verified through
# POST /api/auth/email/verify. There is no separate enable flag; configuring the
# relay is the switch, matching NOTIFY_TRANSPORT above.
#
# Read this before enabling it:
#
#   The phone stays the credential of record — a session is issued for the number
#   the challenge was bound to, and the email only ever receives a copy. But once
#   a code arrives in a mailbox, whoever can read that mailbox can sign in. Doing
#   this makes account security the WEAKER of the two channels, not the stronger.
#   That is the trade being made; it is not an oversight.
#
#   This is why an address must be verified first, and why `email` is rejected by
#   PATCH /api/users/:id. An address a borrowed session could set would otherwise
#   receive every future code — permanent ownership.
#
# Email delivery is best effort: if the relay is down the sign-in still succeeds,
# because the code already reached the phone. A phone failure is still fatal.
#
# --- Option A: HTTP providers (works on any host) ----------------------------
# Preferred, and required on Railway: Railway blocks outbound SMTP (25, 465,
# 587, 2525) on its Hobby and Trial plans, so nodemailer fails there with
# ESOCKET before it ever reaches a credential. These all go over HTTPS.
#
# Set as many as you like. They are tried in order until one delivers, so no
# single provider being down or out of quota can stop sign-in — which matters
# because sign-in is passwordless and has no other way in.
#
# EMAIL_FROM must be a sender the provider has accepted. Brevo, SendGrid,
# MailerSend and Mailtrap can verify a single ADDRESS (a plain Gmail works).
# Resend requires a verified DOMAIN and will otherwise only deliver to the
# address its account was created with.
#
# NOTE ON SPAM: sending "from" a free mailbox (gmail.com) through another
# company is accepted but is more likely to be filtered, and a code in a spam
# folder is a customer who cannot sign in. A verified domain of your own is the
# only real fix; more providers do not help, because they all hit it equally.
EMAIL_FROM=VegDrop <no-reply@yourdomain.com>
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# MAILERSEND_API_KEY=
# MAILTRAP_API_TOKEN=
# PLUNK_API_KEY=
# RESEND_API_KEY=
#
# Order to try them in. The default puts daily-resetting allowances first so the
# monthly pools are held back for a day that needs them.
# EMAIL_PROVIDER_ORDER=brevo,sendgrid,mailersend,mailtrap,plunk,resend
# EMAIL_TIMEOUT_MS=10000

# --- Option B: SMTP ----------------------------------------------------------
# Works with any relay, on a host that permits SMTP. For Gmail, SMTP_PASS must be
# an App Password (a normal account password is refused once 2FA is on), host
# smtp.gmail.com, port 587. Ignored when RESEND_API_KEY is set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# 465 is implicit TLS (secure=true); 587 is STARTTLS (secure=false). Mismatching
# the port and this flag is the usual cause of a hang at connect.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Most relays reject a message whose sender is not an address the account may
# send as. Required whenever SMTP_HOST is set.
# SMTP_FROM=VegDrop <no-reply@yourdomain.com>
# SMTP_TIMEOUT_MS=10000

# --- Unofficial WhatsApp bot (server/bot) ------------------------------------
# Free, no Meta account, no template approval. Also against WhatsApp's Terms of
# Service — Meta bans numbers for this, without warning. Do not make it the only
# path to your login flow. Read server/bot/README.md.
#
# Run it with:  npm run bot   (separate process; scan the QR once to pair)
#
# Shared secret for the loopback bridge between the API and the bot. Required
# when NOTIFY_TRANSPORT=whatsapp_bot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WHATSAPP_BOT_BRIDGE_TOKEN=
#
# The bridge can send WhatsApp messages as you. Keep it on loopback — never bind
# it to 0.0.0.0 and never expose it through a reverse proxy.
# WHATSAPP_BOT_BRIDGE_HOST=127.0.0.1
# WHATSAPP_BOT_BRIDGE_PORT=5055
# WHATSAPP_BOT_BRIDGE_TIMEOUT_MS=30000
#
# Session credentials directory, relative to server/bot/. Gitignored. This IS the
# linked-device session — anyone with a copy can send as you.
# WHATSAPP_BOT_AUTH_DIR=.auth
# WHATSAPP_BOT_COUNTRY_CODE=91
#
# Ban-risk pacing. Raising any of these raises the risk of losing the number;
# a new number sending at volume on day one is the clearest signal there is.
# WHATSAPP_BOT_MIN_INTERVAL_MS=3000
# WHATSAPP_BOT_JITTER_MS=2000
# WHATSAPP_BOT_DAILY_CAP=200
# WHATSAPP_BOT_RECIPIENT_COOLDOWN_MS=60000
# WHATSAPP_BOT_VERBOSE=false

# --- Payments ----------------------------------------------------------------
# Server-side only. The key id is echoed to the browser to open Razorpay
# checkout; the secret signs and verifies and must never leave the server.
# Production requires real credentials — mock payment mode is refused there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A THIRD credential, and not the key secret above — Razorpay signs webhook
# bodies with a value you choose yourself when registering the endpoint in their
# dashboard, and verifying with the key secret simply never matches.
#
# Point the dashboard at POST https://<your-host>/api/wallet/webhook and
# subscribe to `payment.captured` and `payment.failed`.
#
# Required in production. Without it, the browser calling /topup/verify is the
# only thing that credits a wallet, so a tab closed in the seconds after paying
# means the money was captured and never credited, with nothing to reconcile it.
RAZORPAY_WEBHOOK_SECRET=

# --- Payouts (RazorpayX) -----------------------------------------------------
# A DIFFERENT product from Razorpay Payments above, with its own credentials.
# Payments credentials collect money and cannot send it, so these are required
# separately for the vendor KYC penny drop.
#
# Production requires all three — a vendor cannot be verified in mock mode.
# Left unset in development, transfers are simulated and the amount is printed
# to the server console instead of being sent.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# --- Vendor KYC --------------------------------------------------------------
# Encrypts PAN and bank account numbers at rest (AES-256-GCM). Required in
# production; a random ephemeral key is generated per run in development.
#
# WARNING: changing this key makes every existing KYC record undecryptable.
# Treat it as permanent once vendors are onboarded.
KYC_ENCRYPTION_KEY=

# Penny-drop amount range, in paise. Randomised within this window so the vendor
# must read their own statement to pass — a fixed amount would let anyone guess.
KYC_PENNY_MIN_PAISE=1
KYC_PENNY_MAX_PAISE=100
KYC_PENNY_MAX_ATTEMPTS=5
KYC_PENNY_TTL_SECONDS=604800

# --- Development seed accounts -----------------------------------------------
# Optional. Seeding runs only outside production. Leave these unset and the
# seeder generates a random password per account, printed once at startup.
# SEED_CUSTOMER_PASSWORD=
# SEED_SHOPKEEPER_PASSWORD=
# SEED_DELIVERY_PASSWORD=
# SEED_MARKET_OWNER_PASSWORD=
# SEED_DEVELOPER_PASSWORD=

# =============================================================================
# VegBazzar — server configuration
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.
#
# IMPORTANT: Vite inlines any variable prefixed VITE_ into the browser bundle.
# Never put a password, API secret, or connection string behind a VITE_ prefix.
# Everything below is server-side only and deliberately unprefixed.
#
# Role membership is no longer configured here. A user's role lives on their
# database record and is assigned by an admin via PATCH /api/users/:id/role.
# =============================================================================

NODE_ENV=development
PORT=5000

# --- Database ----------------------------------------------------------------
# Local development. Production requires a replica set: the wallet ledger and
# order checkout use multi-document transactions, which a standalone mongod
# cannot run (the server refuses to boot in production without them).
MONGODB_URI=mongodb://127.0.0.1:27017/vegbazzar
# Atlas — substitute your own cluster, user, and password:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vegbazzar?retryWrites=true&w=majority

# --- Session secrets ---------------------------------------------------------
# Required in production; the process aborts at boot if absent. In development a
# random ephemeral secret is generated per run (sessions reset on restart).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Mixed into OTP hashes so a database leak alone does not reveal live codes.
OTP_PEPPER=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- CORS --------------------------------------------------------------------
# Comma-separated absolute origins. Required in production.
# Do NOT widen this to a private-network range: every device on the same Wi-Fi
# would then be able to drive the API with credentials attached.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set when running behind a reverse proxy so rate limiting sees the real client
# IP rather than the proxy's.
# TRUST_PROXY=1

# --- Authentication policy ---------------------------------------------------
AUTH_MIN_PASSWORD_LENGTH=10
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCKOUT_SECONDS=900

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Payments ----------------------------------------------------------------
# Server-side only. The key id is echoed to the browser to open Razorpay
# checkout; the secret signs and verifies and must never leave the server.
# Production requires real credentials — mock payment mode is refused there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Development seed accounts -----------------------------------------------
# Optional. Seeding runs only outside production. Leave these unset and the
# seeder generates a random password per account, printed once at startup.
# SEED_CUSTOMER_PASSWORD=
# SEED_SHOPKEEPER_PASSWORD=
# SEED_DELIVERY_PASSWORD=
# SEED_MARKET_OWNER_PASSWORD=
# SEED_DEVELOPER_PASSWORD=
